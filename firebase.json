{
  "hosting": {
    "site": "goals-v24",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "downloads/**",
      "**/*.apk",
      "**/*.zip",
      "**/*.exe"
    ],
    "rewrites": [
      {
        "source": "!/downloads/**",
        "destination": "/index.html"
      }
    ]
  }
}
