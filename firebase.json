{
  "hosting": {
    "site": "goalskid",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.apk",
      "**/*.zip",
      "**/*.exe",
      "**/downloads/*.apk",
      "**/downloads/*.zip"
    ],
    "rewrites": [
      {
        "source": "!/downloads/**",
        "destination": "/index.html"
      }
    ]
  }
}
